# Pinned upstream sources retain exact bytes, including upstream whitespace.
rust/crates/looper/vendor/signalsmith/signalsmith-stretch.h -text -whitespace
rust/crates/looper/vendor/signalsmith/signalsmith-linear/stft.h -text -whitespace
rust/crates/looper/vendor/signalsmith/signalsmith-linear/fft.h -text -whitespace
rust/crates/looper/vendor/signalsmith/STRETCH-LICENSE.txt -text
rust/crates/looper/vendor/signalsmith/LINEAR-LICENSE.txt -text
rust/crates/looper/vendor/signalsmith/provenance.json text eol=lf
rust/crates/looper/vendor/asio-sdk/common/*.h -text -whitespace
rust/crates/looper/vendor/asio-sdk/LICENSE.txt -text -whitespace
rust/crates/looper/vendor/asio-sdk/common/LICENSE.txt -text -whitespace
rust/crates/looper/vendor/asio-sdk/README.md text eol=lf
rust/crates/looper/vendor/asio-sdk/provenance.json text eol=lf
rust/vendor/cpal/** -text -whitespace
rust/vendor/cpal/looper-provenance.json text eol=lf

# Unified diff context markers precede upstream tabs and empty source lines.
scripts/native/vcpkg-overlay/libsamplerate/stereo-controls.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol

# Native BeatThis CUDA manifests are hashed as exact loader inputs.
workers/beat_this/native_cuda/*.json text eol=lf

# HTDemucs worker and App bind the same source-owned approval bytes.
workers/htdemucs/native_cpu/*.json text eol=lf
