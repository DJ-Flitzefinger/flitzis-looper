class CommittedStemSetTicket:
    # Source-bound disk selection receipt; not resident/effective audio authority.
    def publication_status(self) -> Literal["captured", "pending", "accepted", "rejected"]: ...
    def error(self) -> str | None: ...
    def is_current(self) -> bool: ...
    def cancel(self) -> bool: ...

class ResidentStemTicket:
    # Residency and effective selection have separate callback-owned receipts.
    def residency_status(self) -> Literal["captured", "pending", "accepted", "rejected"]: ...
    def effective_mode_status(
        self,
    ) -> Literal["not_requested", "waiting", "transitioning", "effective", "rejected"]: ...
    def effective_failure_reason(self) -> Literal["native-preparation-failed"] | None: ...
    def error(self) -> str | None: ...
    def is_current(self) -> bool: ...
    def cancel(self) -> bool: ...
    def withdraw(self) -> bool: ...
    def claimed(self) -> bool: ...

class ResidentWindowTicket:
    # Complete source stays stable; effective window changes only on native ACK.
    def publication_status(
        self,
    ) -> Literal[
        "preparing", "pending", "adopting", "accepted", "rejected", "failed", "cancelled"
    ]: ...
    def error(self) -> str | None: ...
    def cancel(self) -> bool: ...
    def cancel_launch(self) -> bool: ...
    def is_current(self) -> bool: ...
    @property
    def key_lock_request_id(self) -> int | None: ...
    @property
    def previous_window_revision(self) -> int: ...
    @property
    def effective_seek_seconds(self) -> float | None: ...
    @property
    def window_revision(self) -> int: ...
    @property
    def start_frame(self) -> int: ...
    @property
    def end_frame(self) -> int: ...
    @property
    def full_frame_count(self) -> int: ...

