from collections.abc import Sequence
from typing import Literal

import numpy as np
from numpy.typing import NDArray

def resolve_project_asset(samples_root: str, path: str) -> tuple[str, str, str | None]: ...
def native_build_profile() -> Literal["debug", "release"]: ...
def summarize_selected_bpm_json(
    beat_seconds: Sequence[float],
    sample_rate_hz: int,
    frame_count: int,
    quarter_counts: Sequence[int | None] | None = None,
    quarter_note_denominator: int = 1,
    count_provenance: str = "selected-backend ordinal assumption",
) -> str: ...

class ScalarSourceGrid:
    # Pure source-second projection, independent of live native BPM/rate state.

    def __init__(self, origin_s: float, seconds_per_beat: float) -> None: ...
    def beat_at_source(self, source_s: float) -> float | None: ...
    def source_at_beat(self, beat: float) -> float | None: ...
    def source_after_beats(self, source_s: float, beats: float) -> float | None: ...

class AudioMessage:
    def sample_id(self) -> int | None: ...
    def pad_peak(self) -> float | None: ...
    def master_peak(self) -> float | None: ...
    def pad_playhead(self) -> float | None: ...

    class Pong(AudioMessage):
        def __init__(self) -> None: ...

    class SampleStarted(AudioMessage):
        def __init__(self, pad_id: int) -> None: ...

    class SampleStopped(AudioMessage):
        def __init__(self, pad_id: int) -> None: ...

    class PadPeak(AudioMessage):
        def __init__(self, pad_id: int, peak: float) -> None: ...

    class MasterPeak(AudioMessage):
        def __init__(self, peak: float) -> None: ...

    class PadPlayhead(AudioMessage):
        def __init__(self, pad_id: int, position_s: float) -> None: ...

class OfflineAnalysisJob:
    def metadata(self) -> dict[str, object]: ...
    def staging_stats(self) -> dict[str, int]: ...
    def prepare_export(self, path: str) -> None: ...
    def analyze_key(self) -> str: ...
    def analyze_corrected_legacy(self, analyzer_output_path: str | None = None) -> str: ...
    def is_cancelled(self) -> bool: ...
    def cancel(self) -> None: ...
    def abort_unstarted(self) -> None: ...
    def retire_pcm(self) -> None: ...
    def progress(self, stage: str) -> None: ...
    def finish(self, result_json: str) -> bool: ...
    def finish_corrected_legacy(self, result_json: str) -> bool: ...

class PreparedSourceTicket:
    # Opaque native source/request/timing admission identity; not persistable.
    def publication_status(self) -> Literal["captured", "pending", "accepted", "rejected"]: ...
    def same_source_request(self, other: PreparedSourceTicket) -> bool: ...
    def rejection_reason(
        self,
    ) -> (
        Literal[
            "pad-playing",
            "source-request-changed",
            "timing-changed",
            "window-changed",
            "invalid-geometry",
            "unspecified",
        ]
        | None
    ): ...

class PreparedStemPair:
    # Complete disk selection and optional four-component worker result; never an ACK.
    def selection_json(self) -> str: ...
    def has_components(self) -> bool: ...
    def select(self) -> None: ...
    def discard(self) -> None: ...
    def instrumental_reader(self) -> InstrumentalStemReader: ...

class InstrumentalStemReader:
    # Offline complete-pair pins, with actual Instrumental PCM and no live-layer ACK.
    def geometry(self) -> tuple[int, int, int, int]: ...
    def read_f32le(self) -> bytes: ...

class ResidentWindowTicket:
    # Complete source stays stable; effective window changes only on native ACK.
    def publication_status(
        self,
    ) -> Literal[
        "preparing", "pending", "adopting", "accepted", "rejected", "failed", "cancelled"
    ]: ...
    def error(self) -> str | None: ...
    def cancel(self) -> bool: ...
    def cancel_launch(self) -> bool: ...
    def is_current(self) -> bool: ...
    @property
    def previous_window_revision(self) -> int: ...
    @property
    def effective_seek_seconds(self) -> float | None: ...
    @property
    def window_revision(self) -> int: ...
    @property
    def start_frame(self) -> int: ...
    @property
    def end_frame(self) -> int: ...
    @property
    def full_frame_count(self) -> int: ...

class ProjectAssetLease:
    # Opaque process owner; final cleanup is serialized on the native control worker.
    def release(self) -> None: ...
    def acknowledge(self, expected_path: str) -> None: ...
    def reclaim_stems(self, expected_path: str) -> None: ...
    @property
    def released(self) -> bool: ...

class ConstantTimingTicket:
    # Opaque actual loaded-source/QM/request capture; cannot be persisted or constructed.
    def metadata(self) -> dict[str, object]: ...
    def publication_status(self) -> Literal["captured", "pending", "accepted", "rejected"]: ...
    def accepted_metadata(self) -> dict[str, object] | None: ...

class CapturedConstantTiming:
    # Opaque synchronous immutable source/request capture for off-thread preparation.
    ...

class AcceptedTimingRefreshTicket:
    def publication_status(self) -> Literal["pending", "accepted", "rejected"]: ...
    def is_current(self) -> bool: ...

class InputRuntimePadBinding:
    # Opaque current native source/authority snapshot; no PCM owner or persisted identity.
    def metadata(self) -> dict[str, object]: ...

class GlobalPlaybackBatchTicket:
    # Native execution acknowledgement; queue admission remains pending.
    def publication_status(self) -> Literal["pending", "accepted", "rejected"]: ...

class SavedConstantTimingTicket:
    # Fresh captured restore request; historical JSON never proves current authority.
    ...

class MigrationArtifactLease:
    @staticmethod
    def capture(samples_root: str, reference: str) -> MigrationArtifactLease: ...
    @staticmethod
    def reopen(samples_root: str, receipt_json: str) -> MigrationArtifactLease: ...
    def receipt_json(self) -> str: ...
    def retire(self, inventory: MigrationInventoryLease) -> None: ...
    def retirement_status(self) -> str: ...
    def retirement_error(self) -> str | None: ...
    def release(self) -> None: ...

class MigrationInventoryLease:
    def records(self) -> list[str]: ...
    def release(self) -> None: ...

class MigrationProjectGuard:
    def __init__(self, samples_root: str, config_reference: str) -> None: ...
    @property
    def instance_id(self) -> str: ...
    @staticmethod
    def inventory(samples_root: str) -> list[str]: ...
    def lock_inventory(self) -> MigrationInventoryLease: ...
    def release(self) -> None: ...

class MaterialMigrationPreparation:
