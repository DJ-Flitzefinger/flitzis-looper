class AudioMessage:
    def sample_id(self) -> int | None: ...
    def pad_peak(self) -> float | None: ...
    def master_peak(self) -> float | None: ...
    def pad_playhead(self) -> float | None: ...
    def feedback_kind(self) -> str | None: ...

    class Pong(AudioMessage):
        def __init__(self) -> None: ...

    class SampleStarted(AudioMessage):
        def __init__(self, pad_id: int) -> None: ...

    class SampleStopped(AudioMessage):
        def __init__(self, pad_id: int) -> None: ...

    class PadPeak(AudioMessage):
        def __init__(self, pad_id: int, peak: float) -> None: ...

    class MasterPeak(AudioMessage):
        def __init__(self, peak: float) -> None: ...

    class PadPlayhead(AudioMessage):
        def __init__(self, pad_id: int, position_s: float) -> None: ...

    class ContentFeedback(AudioMessage):
        def __init__(
            self,
            id: int,  # noqa: A002 - Native enum constructor exposes this Rust field name.
            owner: int,
            cell: int,
            lifetime: int,
            transport_revision: int,
            kind: int,
            value: float,
        ) -> None: ...

    class OrdinaryTransportFeedback(AudioMessage):
        owner: int
        cell: int
        lifetime: int
        transport_revision: int
        observation_sequence: int
        def __init__(
            self,
            id: int,  # noqa: A002 - Native enum constructor exposes this Rust field name.
            owner: int,
            cell: int,
            lifetime: int,
            transport_revision: int,
            observation_sequence: int,
        ) -> None: ...

